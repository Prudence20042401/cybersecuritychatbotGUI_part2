<Window x:Class="CyberSecurityChatbotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Chatbot"
        Height="650"
        Width="950"
        Background="Black">

    <Grid>

        <!-- Chatbot title -->
        <TextBlock Text="CYBERSECURITY CHATBOT"
                   Foreground="Cyan"
                   FontSize="40"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0"/>

        <!-- ASCII art -->
        <TextBlock x:Name="txtAsciiArt"
                   Foreground="Cyan"
                   FontFamily="Consolas"
                   FontSize="12"
                   Margin="10,70,0,0"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Center"/>

        <!-- Chat area -->
        <RichTextBox x:Name="rtbChat"
                     Margin="20,300,20,100"
                     Background="#111111"
                     Foreground="White"
                     FontFamily="Consolas"
                     FontSize="14"
                     VerticalScrollBarVisibility="Auto"
                     IsReadOnly="True"/>

        <!-- User input -->
        <TextBox x:Name="txtUserInput"
                 Height="40"
                 Margin="20,0,140,20"
                 VerticalAlignment="Bottom"
                 FontSize="14"
                 Background="#222222"
                 Foreground="White"
                 BorderBrush="Cyan"
                 KeyDown="txtUserInput_KeyDown"/>

        <!-- Send button -->
        <Button x:Name="btnSend"
                Content="Send"
                Width="100"
                Height="40"
                Margin="0,0,20,20"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="DarkCyan"
                Foreground="White"
                Click="btnSend_Click"/>

    </Grid>
</Window>