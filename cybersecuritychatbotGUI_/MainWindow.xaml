<Window x:Class="CyberSecurityChatbotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Assistant"
        Height="750"
        Width="1200"
        Background="Black"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- CYBER TITLE -->

        <TextBlock
            Text="CYBERSECURITY AWARENESS ASSISTANT"
            FontSize="28"
            FontWeight="Bold"
            Foreground="Cyan"
            HorizontalAlignment="Center"
            Margin="0,10"/>

        <TabControl Name="MainTabs"
                    Grid.Row="1"
                    Background="#111111"
                    Foreground="Cyan"
                    BorderBrush="Cyan">

            <!-- CHAT TAB -->

            <TabItem Header="Chat"
                     Name="ChatTab"
                     Background="Cyan">

                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Name="txtAsciiArt"
                               FontFamily="Consolas"
                               Foreground="Cyan"
                               Margin="10"/>

                    <RichTextBox Name="rtbChat"
                                 Grid.Row="1"
                                 Margin="0,10"
                                 Background="Black"
                                 Foreground="White"
                                 BorderBrush="Cyan"
                                 IsReadOnly="True"/>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal">

                        <TextBox Name="txtUserInput"
                                 Width="850"
                                 Height="35"
                                 Background="#222222"
                                 Foreground="White"
                                 BorderBrush="Cyan"
                                 KeyDown="txtUserInput_KeyDown"/>

                        <Button Name="btnSend"
                                Content="Send"
                                Width="100"
                                Margin="10,0"
                                Background="Cyan"
                                Foreground="Black"
                                FontWeight="Bold"
                                Click="btnSend_Click"/>

                    </StackPanel>

                </Grid>

            </TabItem>


            <!-- TASK TAB -->

            <TabItem Header="Tasks"
                     Name="TaskTab"
                     Background="Cyan">

                <StackPanel Margin="10">

                    <TextBlock Text="Task Assistant"
                               FontSize="18"
                               Foreground="Cyan"
                               FontWeight="Bold"/>

                    <TextBox Name="txtTaskTitle"
                             Text="Enter task title"
                             Margin="0,10"
                             Background="#222222"
                             Foreground="White"
                             BorderBrush="Cyan"
                             GotFocus="txtTaskTitle_GotFocus"
                             LostFocus="txtTaskTitle_LostFocus"/>

                    <TextBox Name="txtDescription"
                             Text="Enter task description"
                             Height="80"
                             Margin="0,10"
                             Background="#222222"
                             Foreground="White"
                             BorderBrush="Cyan"
                             GotFocus="txtDescription_GotFocus"
                             LostFocus="txtDescription_LostFocus"/>

                    <DatePicker Name="dpReminder"/>

                    <Button Name="btnAddTask"
                            Content="Add Task"
                            Width="120"
                            Margin="0,10"
                            Background="Cyan"
                            Foreground="Black"
                            Click="btnAddTask_Click"/>

                    <ListBox Name="TaskList"
                             Background="#222222"
                             Foreground="White"/>

                </StackPanel>

            </TabItem>


            <!-- QUIZ TAB -->

            <TabItem Header="Quiz"
                     Name="QuizTab"
                     Background="Cyan">

                <StackPanel>

                    <Button
                        Name="btnStartQuiz"
                        Content="START QUIZ"
                        FontSize="22"
                        Width="250"
                        Height="80"
                        Margin="100"
                        Background="Cyan"
                        Foreground="Black"
                        FontWeight="Bold"
                        Click="btnStartQuiz_Click"/>

                    <TextBlock
                        Name="txtQuestion"
                        FontSize="18"
                        Foreground="White"
                        Visibility="Collapsed"/>

                    <ListBox
                        Name="lstAnswers"
                        Height="150"
                        Background="#222222"
                        Foreground="White"
                        Visibility="Collapsed"/>

                    <Button
                        Name="btnSubmitQuiz"
                        Content="Submit Answer"
                        Width="150"
                        Background="Cyan"
                        Foreground="Black"
                        Visibility="Collapsed"
                        Click="btnQuizAnswer_Click"/>

                </StackPanel>

            </TabItem>


            <!-- ACTIVITY LOG -->

            <TabItem Header="Activity Log"
                     Name="LogTab"
                     Background="Cyan">

                <ListBox Name="lstLogs"
                         Background="#222222"
                         Foreground="White"/>

            </TabItem>

        </TabControl>

    </Grid>

</Window>